 # Neon PostgreSQL connection string from the Neon dashboard.
 # Keep the password URL-encoded and use the pooled connection string for deployed apps.
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require
ENVIRONMENT=production
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# If frontend and API are deployed together (the default), this can be the app URL.
ALLOWED_ORIGINS=https://your-app.example.com
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# API configuration
API_HOST=0.0.0.0
API_PORT=8000
